# =========================
# Local development (SQLite, optional)
# =========================
# SQLite is derived from the PostgreSQL Prisma schema at runtime for local dev.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
DIRECT_URL=

# =========================
# Auth / URLs (no hardcoded localhost in production; set real staging/prod URLs)
# =========================
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Legacy alias supported by the app; prefer NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy/external backend base URL (optional, not used by the Next.js-only staging app; kept for legacy local workflows if needed).
NEXT_PUBLIC_API_URL=http://localhost:5001


# =========================
# App / security
# =========================
ADMIN_EMAIL=admin@mtclub.local
ADMIN_PASSWORD=
QR_TOKEN_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-a-random-secret
ABSENCE_WARNING_THRESHOLD=3
RESEND_API_KEY=
AUTH_EMAIL_FROM="MT Club <accounts@example.com>"
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =========================
# Storage (STORAGE_DRIVER: local | supabase | cloudinary)
# - local: development only (writes to public/uploads; not persistent on Vercel)
# - supabase: Supabase Storage (server-side keys)
# - cloudinary: Cloudinary (recommended/default for production)
# Defaults: local in development, cloudinary in production when unset.
# =========================
STORAGE_DRIVER=local
# Supabase Storage (server-only; never expose secret key publicly)
SUPABASE_URL=
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_STORAGE_BUCKET=club-assets
# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# Web Push / VAPID (all from env)
# Generate with: npx web-push generate-vapid-keys
# =========================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# =========================
# Legacy / optional integrations
# =========================
JOIN_WEBHOOK_URL=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
VITE_API_URL=http://localhost:5001
VITE_ONESIGNAL_APP_ID=

# =========================
# Staging/Production (PostgreSQL, e.g. Neon/Supabase Postgres) - NEW Vercel project
# =========================
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# AUTH_URL=https://your-staging-app.vercel.app
# NEXT_PUBLIC_APP_URL=https://your-staging-app.vercel.app
# NEXT_PUBLIC_SITE_URL=https://your-staging-app.vercel.app
# STORAGE_DRIVER=cloudinary
# For hosted Postgres, run migrations with: npx prisma migrate deploy
# For local dev against Postgres with schema iteration, you may set PRISMA_MIGRATE_DEV=1 (not for production)

