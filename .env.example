DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mtclub?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/mtclub
AUTH_SECRET=
QR_TOKEN_SECRET=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://mtclub.example.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=MT Club <accounts@mtclub.example.com>

# Bootstrap is only used by `npm run db:seed`; public registration is disabled.
ADMIN_NAME=MT Club Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Seed-generated leader/member passwords are random, temporary, and printed once by `npm run db:seed`.

# Supabase Storage (server-only service-role secret; never use NEXT_PUBLIC_ here).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=club-assets

# Web Push VAPID credentials. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Existing backend and legacy Vite/Capacitor settings
JOIN_WEBHOOK_URL=
ALLOWED_ORIGINS=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
VITE_API_URL=
VITE_ONESIGNAL_APP_ID=
