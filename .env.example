# Local development defaults. SQLite is derived from the PostgreSQL Prisma schema.
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db
DIRECT_URL=
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001
ADMIN_EMAIL=admin@mtclub.local
ADMIN_PASSWORD=
QR_TOKEN_SECRET=
CRON_SECRET=
ABSENCE_WARNING_THRESHOLD=3
RESEND_API_KEY=
AUTH_EMAIL_FROM=MT Club <accounts@mtclub.example.com>

# Supabase Storage (server-only service-role secret; never use NEXT_PUBLIC_ here).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=club-assets

# Web Push VAPID credentials. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Existing backend and legacy Vite/Capacitor settings
JOIN_WEBHOOK_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
VITE_API_URL=http://localhost:5001
VITE_ONESIGNAL_APP_ID=

# For production, set DATABASE_PROVIDER=postgresql and provide PostgreSQL URLs.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mtclub?pgbouncer=true
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/mtclub
